{
  "name": "metricas-software-lab3-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:notifications && npm run build:delivery && npm run build:scripts",
    "build:notifications": "tsc -p services/notifications-api/tsconfig.json",
    "build:delivery": "tsc -p services/delivery-provider/tsconfig.json",
    "build:scripts": "tsc -p scripts/tsconfig.json",
    "dev:notifications": "tsx services/notifications-api/src/server.ts",
    "dev:delivery": "tsx services/delivery-provider/src/server.ts",
    "scenario": "tsx scripts/scenario.ts",
    "probe:retry": "tsx scripts/probe-retry.ts",
    "probe:privacy": "tsx scripts/probe-privacy.ts",
    "validate": "tsx scripts/validate.ts",
    "reset": "tsx scripts/reset.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "express": "5.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
